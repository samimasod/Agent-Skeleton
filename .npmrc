# Use hoisted node_modules so Expo/Metro can resolve packages correctly.
# Without this, pnpm's default symlink-based virtual store causes Metro to
# fail to find packages like react-native-web.
node-linker=hoisted

# Shamefully hoist all packages to the root node_modules (npm/yarn behaviour).
# Required for Expo/Metro which does not traverse pnpm's nested workspace layout.
shamefully-hoist=true
